# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Configuration
# Option 1: Local MongoDB (requires MongoDB installed)
# MONGODB_URI=mongodb://localhost:27017/droobee-marketplace

# Option 2: MongoDB Atlas (Cloud - Recommended)
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/droobee-marketplace?retryWrites=true&w=majority&appName=Cluster0

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=your-api-identifier

# Email Configuration (Optional - will log to console if not configured)
# For Gmail: Use app-specific password at https://myaccount.google.com/apppasswords
# For SendGrid: Get API key at https://app.sendgrid.com/settings/api_keys
# For other providers: Configure SMTP settings below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="DROOBEE <noreply@droobee.com>"

# Alternative: SendGrid Configuration
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key

# Stripe Configuration (Optional)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin WhatsApp Number (Optional)
ADMIN_WHATSAPP_NUMBER=+1234567890

# Twilio Configuration for WhatsApp (Optional)
# Get your credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
