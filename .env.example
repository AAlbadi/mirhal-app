# Supabase Configuration
# Get these from specific Supabase Project: mirhal-marketplace
VITE_SUPABASE_URL=https://your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Auth (Required for Capgo Social Login)
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials
# 2. Create "OAuth Client ID" -> Application Type: "Web application"
# 3. Add Authorized Origins: http://localhost:5173 and https://mirhal.app
# 4. Copy "Client ID" and paste below:
VITE_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
