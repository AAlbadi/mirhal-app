rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to upload reviews
    // Path: reviews/{spotId}/{filename}
    match /reviews/{spotId}/{fileName} {
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to upload spot images
    // Path: spots/{userId}/{filename}
    match /spots/{userId}/{fileName} {
      allow write: if request.auth != null;
    }

    // Allow authenticated users to upload trail images
    // Path: trails/{filename}
    match /trails/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
